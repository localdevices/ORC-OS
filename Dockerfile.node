# Dockerfile for ORC-OS FastAPI Backend only. This dockerfile is needed to create an additional LiveORC processing node
# The largest difference compared to the main is that this file runs one single supervisor for running the FastAPI
# backend (for REST API communication) and the worker node or nodes connected to it (for processing).
FROM python:3.14-slim AS builder


# Install system dependencies required for rasterio, opencv, and other packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libffi-dev \
    libfftw3-dev \
    libjpeg-dev \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set GDAL environment variables
ENV GDAL_CONFIG=/usr/bin/gdal-config

# Set working directory
WORKDIR /app

# Copy requirements first for better layer caching
COPY pyproject.toml ./
COPY LICENSE ./
COPY README.md ./
# Copy application code
COPY orc_api/ ./orc_api/

# build the wheels
RUN pip install --no-cache-dir --upgrade pip && \
    pip wheel --no-cache-dir --wheel-dir /app/wheels .

# Final stage image creation
FROM python:3.14-slim
# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV ORC_HOME=/app/data
ENV ORC_UPLOAD_DIRECTORY=/app/data/uploads

WORKDIR /app

COPY LICENSE ./
COPY README.md ./

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    supervisor \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# install from prepared wheels
COPY --from=builder /app/wheels /wheels
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir /wheels/* && \
    rm -rf /wheels

# Copy entrypoint script, make executable
COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh

# run the orc app once, just to compile the underlying ffpiv code
RUN orc --help

# get the supervisord config file in place for running API and worker side-by-side
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
# Expose the FastAPI port
EXPOSE 5000

# remove cached stuff
RUN rm -rf /root/.cache/pip
RUN rm -fr /var/lib/apt/lists/*

# Set the entrypoint script
ENTRYPOINT ["./entrypoint.sh"]

# Run API and a celery worker side-by-side using supervisord
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
